---
import { resolvePoster } from "../../posters";
import type { Event, State } from "../../domain";
import { windowNewest, factsLine } from "../../presentation";
import { bogotaWhen } from "../../site-model";
interface Props { posts: Event[]; tmdbCache: State["tmdbCache"] }
const { posts, tmdbCache } = Astro.props;
const codes = { added: "Próximamente", "preventa-opens": "Preventa abierta", "now-in-theaters": "En cartelera", removed: "Ya no disponible" };
---
<div class="history">
  {posts.length === 0 && <p>No hay cambios registrados.</p>}
  {windowNewest(posts).map(p => {
    const poster = resolvePoster(p.snapshot, tmdbCache);
    const when = bogotaWhen(p.createdAt);
    return <article class="post">
      {poster ? <img src={poster} alt={p.snapshot.title} width="92" height="138" loading="lazy" /> : <div class="ph" aria-hidden="true">sin póster</div>}
      <div><p class="code">{codes[p.type]}</p><h2>{p.snapshot.title}</h2>
        {p.snapshot.shortSynopsis && <p class="syn">{p.snapshot.shortSynopsis}</p>}
        <div class="facts">{factsLine(p.snapshot)}{p.snapshot.webUrl && <> · <a href={p.snapshot.webUrl}>Ver en CineColombia</a></>}</div>
      </div>
      <time class="when" datetime={p.createdAt}>{when.date}<br />{when.time}</time>
    </article>;
  })}
</div>
