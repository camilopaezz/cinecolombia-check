---
import "../styles/global.css";
interface Props { title: string; heading?: string }
const { title, heading = title } = Astro.props;
const isHistory = Astro.url.pathname.replace(/\/$/, "") === "/historial";
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Películas, próximos estrenos y preventas de Cine Colombia." />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title={title} href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/feed.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <main class="site">
      <header class="head">
        <div><h1>{heading}</h1></div>
        <div class="aside"><a href="/feed.xml">Suscribirse por RSS</a></div>
      </header>
      <nav class="section-nav" aria-label="Secciones">
        <a href="/" aria-current={!isHistory ? "page" : undefined}>Películas</a>
        <a href="/historial" aria-current={isHistory ? "page" : undefined}>Historial de cambios</a>
      </nav>
      <div id="contenido"><slot /></div>
    </main>
  </body>
</html>
